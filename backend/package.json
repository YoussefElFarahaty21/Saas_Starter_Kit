{
  "name": "saas-starter-backend",
  "version": "1.0.0",
  "description": "Production-ready SaaS Starter Kit — Express + TypeScript + Firestore + Stripe",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon --watch . --ext ts --exec ts-node server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "seed:admin": "ts-node scripts/seedAdmin.ts",
    "lint": "eslint . --ext .ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "firebase-admin": "^12.2.0",
    "google-auth-library": "^9.11.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^6.9.14",
    "stripe": "^16.0.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.0",
    "@types/nodemailer": "^6.4.15",
    "nodemon": "^3.1.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}
